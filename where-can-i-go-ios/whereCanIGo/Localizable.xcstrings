        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "政策更新"
          }
        }
      }
    },
    "privacy.collect.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app has no account, no server, no analytics, no ads and no tracking. We never receive your travel records, visas, photos or any other personal information."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 没有账号、没有服务器、没有分析工具、没有广告，也不会追踪你。我们不会收到你的旅行记录、签证、照片或任何其他个人信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 沒有帳號、沒有伺服器、沒有分析工具、沒有廣告，也不會追蹤你。我們不會收到你的旅行紀錄、簽證、相片或任何其他個人資料。"
          }
        }
      }
    },
    "privacy.collect.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We don't collect your data"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们不收集你的数据"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們不收集你的資料"
          }
        }
      }
    },
    "privacy.contact.body %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questions about privacy? Email %@ or open an issue on GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
