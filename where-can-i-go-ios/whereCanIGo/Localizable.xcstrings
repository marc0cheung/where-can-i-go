    "Delete.Plans.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Permanently delete %1$lld planned trip to %2$@? Recorded visits and saved visas will not be affected. This cannot be undone."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Permanently delete %1$lld planned trips to %2$@? Recorded visits and saved visas will not be affected. This cannot be undone."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久删除前往%2$@的 %1$lld 个计划行程？到访记录和已保存的签证不会受到影响。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久刪除前往%2$@的 %1$lld 個計劃行程？到訪紀錄和已儲存的簽證不會受到影響。此操作無法復原。"
          }
        }
      }
    },
    "Delete.Visits.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Permanently delete %1$lld recorded visit to %2$@? Planned trips and saved visas will not be affected. This cannot be undone."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Permanently delete %1$lld recorded visits to %2$@? Planned trips and saved visas will not be affected. This cannot be undone."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久删除前往%2$@的 %1$lld 条到访记录？计划行程和已保存的签证不会受到影响。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久刪除前往%2$@的 %1$lld 條到訪紀錄？計劃行程和已儲存的簽證不會受到影響。此操作無法復原。"
