    "privacy.apple.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map uses Apple Maps (MapKit), which may load map tiles from Apple. Apple's privacy policy applies to that. The app doesn't ask for your location."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图使用 Apple 地图（MapKit），可能会从 Apple 加载地图图块，相关处理受 Apple 隐私政策约束。App 不会请求获取你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地圖使用 Apple 地圖（MapKit），可能會從 Apple 載入地圖圖塊，相關處理受 Apple 私隱政策規管。App 不會要求取得你的位置。"
          }
        }
      }
    },
    "privacy.apple.title" : {
