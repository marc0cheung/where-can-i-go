    "easteregg.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May everyone be free to explore this planet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "愿大家都可自由探索这地球"
          }
        },
        "zh-Hant" : {
