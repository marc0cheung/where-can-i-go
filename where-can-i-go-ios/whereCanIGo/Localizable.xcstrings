    "The new card replaces the one you received %@. Your nickname for this friend stays the same." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新名片会替换你于 %@ 收到的名片，你为此朋友设置的昵称保持不变。"
