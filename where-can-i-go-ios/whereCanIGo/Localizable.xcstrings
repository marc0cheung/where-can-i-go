    "About" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關於"
          }
        }
      }
    },
    "about.disclaimer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entry policies are maintained by hand and can be out of date. Use them for planning only, and always confirm the current rules with the destination's authorities and your airline before you travel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入境信息由人工维护，可能并非最新，仅供规划参考。出发前请务必向目的地政府部门及航空公司确认最新规定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入境資料由人手維護，可能並非最新，僅供規劃參考。出發前請務必向目的地政府部門及航空公司確認最新規定。"
          }
        }
      }
    },
    "about.mission" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where Can I Go shows where your passport can take you, keeps track of your visas, and remembers the places you've been and want to go."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「跟住去边度」帮你看清楚自己的护照可以去哪里、记录你的签证，以及你去过和想去的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「跟住去邊度」幫你看清楚自己的護照可以去哪裡、記錄你的簽證，以及你去過和想去的地方。"
          }
        }
      }
    },
    "acknowledgements.sources.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entry policies are compiled by hand from these public sources and may be out of date."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入境信息根据以上公开来源人工整理，可能并非最新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入境資料根據以上公開來源人手整理，可能並非最新。"
          }
        }
      }
    },
    "Can't find your answer? Let us know." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到答案？欢迎告诉我们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到答案？歡迎告訴我們。"
          }
        }
      }
    },
