          }
        }
      }
    },
    "Friends and the sharing identity in the file replace the ones on this device." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用文件中的朋友和分享身份替换此设备上的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以檔案中的朋友和分享身分取代此裝置上的資料。"
          }
        }
      }
    },
    "Friends can compare this code with the one shown on their device to confirm a card came from you. Your identity is kept in iCloud Keychain when it's turned on." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友可以核对此安全码与他们设备上显示的是否相同，以确认名片来自你。开启 iCloud 钥匙串时，你的分享身份会保存在其中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友可以核對此安全碼與他們裝置上顯示的是否相同，以確認名片來自你。開啟 iCloud 鑰匙圈時，你的分享身分會保存在其中。"
          }
        }
      }
    },
    "Friends in the file are added, and newer cards update existing friends. The sharing identity is used only if this device doesn't have one yet." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加文件中的朋友，较新的名片会更新现有朋友。此设备尚无分享身份时，才会使用文件中的分享身份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增檔案中的朋友，較新的名片會更新現有朋友。此裝置尚未有分享身分時，才會使用檔案中的分享身分。"
          }
        }
      }
    },
    "Friends see this name on your card. Any nickname works." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友会在你的名片上看到这个名称，可以使用任何昵称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友會在你的名片上看到這個名稱，可以使用任何暱稱。"
          }
        }
      }
    },
    "Friends see this name on your card. Any nickname works. Add a profile photo to share it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友会在你的名片上看到这个名称，可以使用任何昵称。设置头像后即可分享头像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友會在你的名片上看到這個名稱，可以使用任何暱稱。設定頭像後即可分享頭像。"
          }
        }
      }
    },
    "Friends' cards contain other people's travel records. Store this file somewhere private." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友的名片包含他人的旅行记录，请将此文件存放在私人位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友的名片包含他人的旅行紀錄，請將此檔案存放在私人位置。"
          }
        }
      }
    },
    "Future cards from %@ are accepted only from this new identity. Ask %@ to confirm that the safety code in their Sharing settings is %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Future cards from %1$@ are accepted only from this new identity. Ask %2$@ to confirm that the safety code in their Sharing settings is %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后只会接受 %1$@ 以这个新身份制作的名片。请 %2$@ 确认其“分享设置”中的安全码是 %3$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
