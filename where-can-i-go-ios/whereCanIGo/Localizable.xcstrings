    },
    "Exchange travel cards with friends to see where they've been and where they want to go, even offline. Cards update only when a friend shares again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与朋友交换旅行名片，即使离线也能查看彼此去过和想去的地方。朋友再次分享时，名片才会更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與朋友交換旅行名片，即使離線也能查看彼此去過和想去的地方。朋友再次分享時，名片才會更新。"
          }
