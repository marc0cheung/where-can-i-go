    "faq.accuracy.a" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not always. The rules are maintained by hand and can change without notice. Always check with the destination's authorities and your airline before you travel. If a rule is wrong, you can edit it for your passport in the Manage Data tab, and please tell us so we can fix it for everyone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不一定。信息由人工维护，规定可能随时更改。出发前请务必向目的地政府部门及航空公司确认。如发现信息有误，你可以在「管理数据」标签页为你的护照修改，也欢迎告诉我们，让大家都能用上正确信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不一定。資料由人手維護，規定可能隨時更改。出發前請務必向目的地政府部門及航空公司確認。如發現資料有誤，你可以在「管理資料」分頁為你的護照修改，也歡迎告訴我們，讓大家都能用上正確資料。"
          }
        }
      }
    },
    "faq.accuracy.q" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is the entry information always correct?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入境信息一定准确吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入境資料一定準確嗎？"
          }
        }
      }
    },
    "faq.colors.a" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each country is coloured by what your passport needs to enter: Visa Free, Visa on Arrival, ETA or Visa Required. If you saved a valid visa that covers a country, it shows as My Visa instead."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个国家会按你的护照入境所需而上色：免签、落地签、电子旅行授权（eTA）或需要签证。如果你保存了有效且适用的签证，该国家会显示为「我的签证」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個國家會按你的護照入境所需而上色：免簽、落地簽、電子旅行授權（eTA）或需要簽證。如果你儲存了有效且適用的簽證，該國家會顯示為「我的簽證」。"
          }
        }
      }
    },
    "faq.colors.q" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What do the map colours mean?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图上的颜色代表什么？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地圖上的顏色代表甚麼？"
          }
        }
      }
    },
    "faq.contact.a" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Settings → Send Feedback to email us or open an issue on GitHub. You can also find us on Instagram at @wherecanigo_app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前往「设置 → 发送反馈」通过邮件联系我们，或在 GitHub 提交 Issue。你也可以在 Instagram 找到我们：@wherecanigo_app。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前往「設定 → 傳送意見」以電郵聯絡我們，或在 GitHub 提交 Issue。你也可以在 Instagram 找到我們：@wherecanigo_app。"
          }
        }
      }
    },
    "faq.contact.q" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How can I report a problem or suggest an idea?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何反馈问题或提出建议？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何回報問題或提出建議？"
          }
        }
      }
    },
    "faq.data.a" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only on your iPhone. There's no account and no server, so we can't see or recover your data. Export a backup from time to time to keep it safe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会存储在你的 iPhone 上。App 没有账号，也没有服务器，所以我们看不到也无法帮你恢复数据。建议定期导出备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會儲存在你的 iPhone 上。App 沒有帳號，也沒有伺服器，所以我們看不到也無法幫你還原資料。建議定期匯出備份。"
          }
        }
      }
    },
    "faq.data.q" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where is my data stored?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的数据存储在哪里？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的資料儲存在哪裡？"
          }
        }
      }
    },
    "faq.dice.a" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap it to pick a random destination. Long-press it to limit the pick by continent, airline or entry requirement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点可随机选出一个目的地。长按可按大洲、航空公司或入境要求筛选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕點可隨機選出一個目的地。長按可按大洲、航空公司或入境要求篩選。"
          }
        }
      }
    },
    "faq.dice.q" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What does the dice do?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "骰子有什么用？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "骰子有甚麼用？"
          }
        }
      }
    },
    "faq.friends.a" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send your travel card over AirDrop, Messages or any app from the Friends section in Travels. Choose what the card includes in Settings → Sharing. When a friend shares again, their card updates."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「旅程」的「朋友」部分，通过 AirDrop、信息或任何 App 发送你的旅行卡。你可以在「设置 → 分享设置」选择卡片包含的内容。朋友再次分享时，他们的卡片会自动更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「旅程」的「朋友」部分，透過 AirDrop、訊息或任何 App 傳送你的旅行卡。你可以在「設定 → 分享設定」選擇卡片包含的內容。朋友再次分享時，他們的卡片會自動更新。"
          }
        }
      }
    },
    "faq.friends.q" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do I share my travels with friends?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何与朋友分享旅程？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何與朋友分享旅程？"
          }
        }
      }
    },
    "faq.myvisa.a" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a visa in My Visas with its validity dates. While it's valid, the country shows as My Visa. A Schengen visa can cover the whole Schengen area."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「我的签证」添加签证及有效日期。签证有效期间，该国家会显示为「我的签证」。申根签证可覆盖整个申根区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「我的簽證」加入簽證及有效日期。簽證有效期間，該國家會顯示為「我的簽證」。申根簽證可涵蓋整個申根區。"
          }
        }
      }
    },
    "faq.myvisa.q" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do my own visas change the map?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的签证会如何影响地图？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的簽證會如何影響地圖？"
          }
        }
      }
    },
    "faq.passports.a" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hong Kong SAR, Macao SAR, China and Taiwan for now. Want another one? Open an issue on GitHub. Contributions with reliable sources are welcome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前支持香港特区、澳门特区、中国及台湾护照。想加入其他护照？欢迎在 GitHub 提交 Issue，也欢迎附上可靠来源一起贡献。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前支援香港特區、澳門特區、中國及台灣護照。想加入其他護照？歡迎在 GitHub 提交 Issue，也歡迎附上可靠來源一起貢獻。"
          }
        }
      }
    },
    "faq.passports.q" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which passports are supported?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持哪些护照？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援哪些護照？"
          }
        }
      }
    },
    "faq.transfer.a" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to Settings → Export Data and save the backup file. On the new device, use Settings → Import Data. You can replace everything or merge in new records only."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前往「设置 → 导出数据」保存备份文件，然后在新设备使用「设置 → 导入数据」。你可以选择全部替换，或只合并新记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前往「設定 → 匯出資料」儲存備份檔案，然後在新裝置使用「設定 → 匯入資料」。你可以選擇全部取代，或只合併新紀錄。"
          }
        }
      }
    },
    "faq.transfer.q" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do I move my data to a new iPhone?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何把数据迁移到新 iPhone？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何把資料轉移到新 iPhone？"
          }
        }
      }
    },
    "feedback.email.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens your mail app with a new message. Your app version, iOS version and device model are added at the end to help us look into problems. You can delete them before sending."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将在邮件 App 中新建邮件，并在末尾附上 App 版本、iOS 版本和设备型号，方便我们排查问题。你可以在发送前删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會在郵件 App 開啟新郵件，並在結尾附上 App 版本、iOS 版本及裝置型號，方便我們排查問題。你可以在傳送前刪除。"
          }
        }
      }
    },
    "feedback.github.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report a bug, an out-of-date entry policy or an idea on GitHub. Issues are public and need a GitHub account."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 GitHub 反馈错误、过时的入境信息或提出建议。Issue 会公开显示，需要 GitHub 账号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 GitHub 回報錯誤、過時的入境資料或提出建議。Issue 會公開顯示，需要 GitHub 帳號。"
          }
        }
      }
    },
    "feedback.mail.subject" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where Can I Go Feedback"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
